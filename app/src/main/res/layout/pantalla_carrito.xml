<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/temues_bg">

    <!-- Lista de articulos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_articulos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="180dp" />

    <!-- Estado vacío -->
    <LinearLayout
        android:id="@+id/layout_vacio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/carrito_vacio"
            android:textColor="@color/temues_text_muted"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_explorar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/carrito_explorar" />

    </LinearLayout>

    <!-- Footer fijo con total y boton pagar -->
    <LinearLayout
        android:id="@+id/layout_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_card"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/carrito_total"
                android:textColor="@color/temues_navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textColor="@color/temues_navy"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ir_a_pagar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/carrito_ir_a_pagar" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
