<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/temues_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_temues_gradient"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Perfil y ventas"
                android:textColor="@color/white"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="usuario@temues.edu"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Accesos rápidos"
            android:textColor="@color/temues_navy"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_mis_compras"
            style="@style/TemUESWideOption"
            android:text="Mis compras" />
        <TextView style="@style/TemUESWideOption" android:text="Mis favoritos" />
        <TextView style="@style/TemUESWideOption" android:text="Mis productos publicados" />
        <TextView style="@style/TemUESWideOption" android:text="Ventas pendientes de entregar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView style="@style/TemUESInfoLine" android:text="Nombre: pendiente de editar" />
            <TextView style="@style/TemUESInfoLine" android:text="Teléfono: pendiente" />
            <TextView style="@style/TemUESInfoLine" android:text="Bio: vendedor/comprador dentro del campus" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:text="@string/profile_logout" />
    </LinearLayout>
</ScrollView>
